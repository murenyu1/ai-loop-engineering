{
  "description": "为已在 AI Loop 面板启用的精确工作区提供简短恢复入口，需经 Codex 原生审核信任。",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
        "commandWindows": "node \"%PLUGIN_ROOT%/scripts/session-start.mjs\"",
        "timeout": 10,
        "additionalContextLimit": 4500
      }]
    }]
  }
}
